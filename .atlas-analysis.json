  "keyFeatures": [
    "Complete CRUD operations for movie management",
    "AI-powered movie recommendations using LangChain4j",
    "Clean architecture with layered design pattern",
    "OpenAPI/Swagger documentation",
    "PostgreSQL persistence with Spring Data JPA",
    "MapStruct entity-to-DTO mapping",
    "Bean validation for data integrity",
    "Docker containerization support"
  ],
  "publicApiSurface": [
    "GET /movies/all - Get all movies",
    "GET /movies/{id} - Get movie by ID",
    "POST /movies/save - Create new movie",
    "PUT /movies/{id} - Update existing movie",
    "DELETE /movies/delete/{id} - Delete movie",
    "POST /movies/suggest - Get AI movie suggestions"
  ]
